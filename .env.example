# Copy this file to .env and fill in real values. Never commit .env itself.

# MySQL connection string used by Prisma (see prisma/schema.prisma).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://user:password@localhost:3306/jabi_cooperatives"

# Optional overrides for `npm run db:seed` (prisma/seed.ts).
# If unset, the seed script falls back to admin@gmail.com / Admin@123 —
# fine for local development, but set these explicitly before seeding any
# shared or production database.
SEED_ADMIN_EMAIL="admin@gmail.com"
SEED_ADMIN_PASSWORD="change-this-before-deploying"
